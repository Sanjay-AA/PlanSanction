rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rule
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // Applications rule
    match /applications/{appId} {
      // Clients can read/write only their own applications
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.applicantId == request.auth.uid ||
        (request.auth.token.role == 'officer' && resource.data.plotDetails.region == request.auth.token.region) ||
        request.auth.token.role == 'admin'
      );

      // Public read for verification page
      allow get: if true;
    }
  }
}
